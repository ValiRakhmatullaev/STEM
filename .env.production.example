# ==========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env.production and fill in real values

# Django Settings
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=your-super-secret-key-here-generate-with-python-secrets
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com,your-server-ip

# Static & Media Files
DJANGO_STATIC_ROOT=/vol/static
DJANGO_MEDIA_ROOT=/vol/media

# Database (PostgreSQL)
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=stem_production
DATABASE_USER=stem_user
DATABASE_PASSWORD=your-strong-database-password-here
DATABASE_HOST=db
DATABASE_PORT=5432

# CORS & CSRF (IMPORTANT: Set to your real domain!)
DJANGO_CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# QR Check-in Public URL (optional)
CHECKIN_PUBLIC_BASE_URL=https://your-domain.com

# ==========================================
# SECURITY NOTES:
# ==========================================
# 1. Generate SECRET_KEY with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 2. Use strong DATABASE_PASSWORD (min 16 chars, mix of letters/numbers/symbols)
# 3. Replace all "your-domain.com" with your actual domain
# 4. Never commit this file to git!
