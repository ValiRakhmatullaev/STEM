DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-50-plus-character-random-secret-before-running-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DJANGO_STATIC_ROOT=/vol/static
DJANGO_MEDIA_ROOT=/vol/media

DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=stem
DATABASE_USER=stem
DATABASE_PASSWORD=replace-with-strong-random-database-password
DATABASE_HOST=db
DATABASE_PORT=5432
REDIS_URL=redis://redis:6379/0

# Set these to your real domain in production
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost

# Optional: for QR check-in links behind a public domain
CHECKIN_PUBLIC_BASE_URL=
