# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production hardening (when DJANGO_DEBUG=false)
# DJANGO_SECURE_COOKIES=true
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_SECURE_HSTS_PRELOAD=false

# Database (leave DATABASE_ENGINE blank or sqlite3 for local dev)
# For PostgreSQL:
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=stem
# DATABASE_USER=stem
# DATABASE_PASSWORD=your-db-password
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# CORS / CSRF origins (comma-separated). Add LAN IP for mobile dev, e.g. http://192.168.1.10:5173
# DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting: use Redis in multi-worker production so limits are global
# REDIS_URL=redis://redis:6379/0

# DRF throttling (defaults are sane for SPA + anonymous)
# DRF_THROTTLE_ANON=120/minute
# DRF_THROTTLE_USER=600/minute

# S3 / MinIO storage (optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=http://minio:9000
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_DEFAULT_ACL=private

# Google Sheets integration (optional)
# GOOGLE_CREDENTIALS_PATH=google_credentials.json

# Public URL for QR check-in links (optional, e.g. https://yourdomain.com)
# CHECKIN_PUBLIC_BASE_URL=

# Logging
# DJANGO_LOG_LEVEL=INFO
